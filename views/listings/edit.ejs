

<% layout("layouts/boilerplate") %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">

      <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4 p-md-5">

          <h2 class="fw-bold mb-1">✏️ Edit your Listing</h2>
          <p class="text-muted mb-4">Update your listing details below.</p>

          <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=PUT"
            novalidate
            class="needs-validation"
            enctype="multipart/form-data">

            <!-- BASIC INFO -->
            <h6 class="fw-bold text-uppercase text-muted border-bottom pb-2 mb-3">
              Basic Info
            </h6>

            <div class="mb-3">
              <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
              <input
                name="listing[title]"
                value="<%= listing.title %>"
                type="text"
                class="form-control rounded-3"
                required />
              <div class="invalid-feedback">Please enter a title.</div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Description</label>
              <textarea
                name="listing[description]"
                class="form-control rounded-3"
                rows="4"><%= listing.description %></textarea>
            </div>

            <!-- PHOTO -->
            <h6 class="fw-bold text-uppercase text-muted border-bottom pb-2 mb-3 mt-4">
              Photo
            </h6>

            <!-- Current image -->
            <div class="mb-3 position-relative">
              <p class="form-label fw-semibold mb-2">Current Photo</p>
              <img
                src="<%= originalImageUrl %>"
                alt="current listing"
                class="img-fluid rounded-3 w-100"
                style="max-height:220px; object-fit:cover;" />
              <span
                class="position-absolute top-0 start-0 m-2 badge bg-dark"
                style="margin-top:36px !important;">
                Current
              </span>
            </div>

            <!-- Upload new -->
            <div class="mb-3">
              <label class="form-label fw-semibold">
                Replace Image
                <span class="text-muted fw-normal">(leave blank to keep current)</span>
              </label>
              <input
                name="listing[image]"
                type="file"
                class="form-control rounded-3"
                accept="image/*"
                onchange="previewNew(this)" />
            </div>

            <!-- New image preview -->
            <div id="newPreview" class="mb-3" style="display:none;">
              <p class="text-muted small mb-1">New photo preview:</p>
              <img
                id="newPrevImg"
                src=""
                alt="new preview"
                class="img-fluid rounded-3 w-100"
                style="max-height:200px; object-fit:cover;" />
            </div>

            <!-- CATEGORY -->
            <div class="mb-3">
              <label class="form-label fw-semibold">
                Category <span class="text-danger">*</span>
              </label>
              <select name="listing[category]" class="form-select rounded-3" required>
                <option value="" disabled>-- Select a category --</option>
                <option value="trending"      <%= listing.category === 'trending'      ? 'selected' : '' %>>🔥 Trending</option>
                <option value="rooms"         <%= listing.category === 'rooms'         ? 'selected' : '' %>>🛏️ Rooms</option>
                <option value="iconic-cities" <%= listing.category === 'iconic-cities' ? 'selected' : '' %>>🏙️ Iconic Cities</option>
                <option value="mountains"     <%= listing.category === 'mountains'     ? 'selected' : '' %>>⛰️ Mountains</option>
                <option value="castles"       <%= listing.category === 'castles'       ? 'selected' : '' %>>🏰 Castles</option>
                <option value="amazing-pools" <%= listing.category === 'amazing-pools' ? 'selected' : '' %>>🏊 Amazing Pools</option>
                <option value="camping"       <%= listing.category === 'camping'       ? 'selected' : '' %>>⛺ Camping</option>
                <option value="farms"         <%= listing.category === 'farms'         ? 'selected' : '' %>>🐄 Farms</option>
                <option value="arctic"        <%= listing.category === 'arctic'        ? 'selected' : '' %>>❄️ Arctic</option>
                <option value="domes"         <%= listing.category === 'domes'         ? 'selected' : '' %>>🏠 Domes</option>
                <option value="boats"         <%= listing.category === 'boats'         ? 'selected' : '' %>>🚢 Boats</option>
              </select>
              <div class="invalid-feedback">Please select a category.</div>
            </div>

            <!-- PRICING & LOCATION -->
            <h6 class="fw-bold text-uppercase text-muted border-bottom pb-2 mb-3 mt-4">
              Pricing & Location
            </h6>

            <div class="row g-3 mb-3">
              <div class="col-md-4">
                <label class="form-label fw-semibold">
                  Price/night <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text">₹</span>
                  <input
                    name="listing[price]"
                    value="<%= listing.price %>"
                    type="number"
                    min="0"
                    class="form-control rounded-end-3"
                    required />
                  <div class="invalid-feedback">Enter a valid price.</div>
                </div>
              </div>
              <div class="col-md-8">
                <label class="form-label fw-semibold">
                  Country <span class="text-danger">*</span>
                </label>
                <input
                  name="listing[country]"
                  value="<%= listing.country %>"
                  type="text"
                  class="form-control rounded-3"
                  required />
                <div class="invalid-feedback">Enter a country.</div>
              </div>
            </div>

            <div class="mb-4">
              <label class="form-label fw-semibold">
                Location / Address <span class="text-danger">*</span>
              </label>
              <input
                name="listing[location]"
                value="<%= listing.location %>"
                type="text"
                class="form-control rounded-3"
                required />
              <div class="invalid-feedback">Enter a location.</div>
            </div>

            <button type="submit" class="btn btn-danger w-100 py-3 fw-bold rounded-3">
              <i class="fa-solid fa-floppy-disk me-2"></i>Save Changes
            </button>

            <a href="/listings/<%= listing._id %>"
               class="btn btn-outline-secondary w-100 mt-2 rounded-3">
              Cancel
            </a>

          </form>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  function previewNew(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = e => {
        document.getElementById('newPrevImg').src = e.target.result;
        document.getElementById('newPreview').style.display = 'block';
      };
      reader.readAsDataURL(input.files[0]);
    }
  }

  (() => {
    document.querySelectorAll('.needs-validation').forEach(form => {
      form.addEventListener('submit', e => {
        if (!form.checkValidity()) {
          e.preventDefault();
          e.stopPropagation();
        }
        form.classList.add('was-validated');
      });
    });
  })();
</script>