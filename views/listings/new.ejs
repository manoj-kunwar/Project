<% layout("layouts/boilerplate") %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">

      <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4 p-md-5">

          <h2 class="fw-bold mb-1">🏠 List your place</h2>
          <p class="text-muted mb-4">Fill in the details to add your listing.</p>

          <form
            method="POST"
            action="/listings"
            novalidate
            class="needs-validation"
            enctype="multipart/form-data">

            <!-- BASIC INFO -->
            <h6 class="fw-bold text-uppercase text-muted border-bottom pb-2 mb-3">
              Basic Info
            </h6>

            <div class="mb-3">
              <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
              <input
                name="listing[title]"
                type="text"
                class="form-control rounded-3"
                placeholder="Add a catchy title"
                required />
              <div class="invalid-feedback">Please enter a title.</div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Description</label>
              <textarea
                name="listing[description]"
                class="form-control rounded-3"
                rows="4"
                placeholder="Describe what makes your place special..."></textarea>
            </div>

            <!-- PHOTO -->
            <h6 class="fw-bold text-uppercase text-muted border-bottom pb-2 mb-3 mt-4">
              Photo
            </h6>

            <div class="mb-3">
              <label class="form-label fw-semibold">Upload Image</label>
              <input
                name="listing[image]"
                type="file"
                class="form-control rounded-3"
                accept="image/*"
                onchange="previewImg(this)" />
            </div>

            <!-- Image preview -->
            <div id="imgPreview" class="mb-3" style="display:none;">
              <img
                id="prevImg"
                src=""
                alt="preview"
                class="img-fluid rounded-3 w-100"
                style="max-height:220px; object-fit:cover;" />
            </div>

            <!-- CATEGORY -->
            <div class="mb-3">
              <label class="form-label fw-semibold">
                Category <span class="text-danger">*</span>
              </label>
              <select name="listing[category]" class="form-select rounded-3" required>
                <option value="" disabled selected>-- Select a category --</option>
                <option value="trending">🔥 Trending</option>
                <option value="rooms">🛏️ Rooms</option>
                <option value="iconic-cities">🏙️ Iconic Cities</option>
                <option value="mountains">⛰️ Mountains</option>
                <option value="castles">🏰 Castles</option>
                <option value="amazing-pools">🏊 Amazing Pools</option>
                <option value="camping">⛺ Camping</option>
                <option value="farms">🐄 Farms</option>
                <option value="arctic">❄️ Arctic</option>
                <option value="domes">🏠 Domes</option>
                <option value="boats">🚢 Boats</option>
              </select>
              <div class="invalid-feedback">Please select a category.</div>
            </div>

            <!-- PRICING & LOCATION -->
            <h6 class="fw-bold text-uppercase text-muted border-bottom pb-2 mb-3 mt-4">
              Pricing & Location
            </h6>

            <div class="row g-3 mb-3">
              <div class="col-md-4">
                <label class="form-label fw-semibold">
                  Price/night <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text">₹</span>
                  <input
                    name="listing[price]"
                    type="number"
                    min="0"
                    class="form-control rounded-end-3"
                    placeholder="0"
                    required />
                  <div class="invalid-feedback">Enter a valid price.</div>
                </div>
              </div>
              <div class="col-md-8">
                <label class="form-label fw-semibold">
                  Country <span class="text-danger">*</span>
                </label>
                <input
                  name="listing[country]"
                  type="text"
                  class="form-control rounded-3"
                  placeholder="e.g. India"
                  required />
                <div class="invalid-feedback">Enter a country.</div>
              </div>
            </div>

            <div class="mb-4">
              <label class="form-label fw-semibold">
                Location / Address <span class="text-danger">*</span>
              </label>
              <input
                name="listing[location]"
                type="text"
                class="form-control rounded-3"
                placeholder="e.g. Baga Beach, North Goa"
                required />
              <div class="invalid-feedback">Enter a location.</div>
            </div>

            <button type="submit" class="btn btn-danger w-100 py-3 fw-bold rounded-3">
              <i class="fa-solid fa-plus me-2"></i>Create Listing
            </button>

          </form>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  function previewImg(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = e => {
        document.getElementById('prevImg').src = e.target.result;
        document.getElementById('imgPreview').style.display = 'block';
      };
      reader.readAsDataURL(input.files[0]);
    }
  }

  (() => {
    document.querySelectorAll('.needs-validation').forEach(form => {
      form.addEventListener('submit', e => {
        if (!form.checkValidity()) {
          e.preventDefault();
          e.stopPropagation();
        }
        form.classList.add('was-validated');
      });
    });
  })();
</script>