<% layout("/layouts/boilerplate.ejs") %>

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">

      <!-- ── TITLE ── -->
      <h2 class="fw-bold mb-1"><%= listing.title %></h2>
      <p class="text-muted mb-3">
        <i class="fa-solid fa-location-dot me-1"></i>
        <%= listing.location %>, <%= listing.country %>
      </p>

      <!-- ── IMAGE ── -->
      <img
        src="<%= listing.image.url %>"
        alt="listing image"
        class="img-fluid rounded-4 w-100 mb-4"
        style="max-height:480px; object-fit:cover;" />

      <!-- ── INFO ROW ── -->
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
          <p class="mb-1 text-muted" style="font-size:0.9rem;">
            Hosted by <strong><%= listing.owner.username %></strong>
          </p>
          <span class="badge rounded-pill text-bg-light border" style="font-size:0.82rem;">
            🏷️ <%= listing.category || 'General' %>
          </span>
        </div>
        <div class="text-end">
          <span class="fs-4 fw-bold text-dark">
            &#8377;<%= listing.price.toLocaleString("en-IN") %>
          </span>
          <span class="text-muted"> /night</span>
        </div>
      </div>

      <!-- ── DESCRIPTION ── -->
      <div class="card border-0 bg-light rounded-4 p-4 mb-4">
        <h5 class="fw-bold mb-2">About this place</h5>
        <p class="text-muted mb-0" style="line-height:1.7;">
          <%= listing.description %>
        </p>
      </div>

      <!-- ── EDIT / DELETE (owner only) ── -->
      <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
        <div class="d-flex gap-2 mb-4">
          <a href="/listings/<%= listing._id %>/edit"
             class="btn btn-dark rounded-3 px-4">
            <i class="fa-solid fa-pen me-1"></i> Edit
          </a>
          <form method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-outline-danger rounded-3 px-4" type="submit"
                    onclick="return confirm('Are you sure you want to delete this listing?')">
              <i class="fa-solid fa-trash me-1"></i> Delete
            </button>
          </form>
        </div>
      <% } %>

      <hr class="my-4" />

      <!-- ── MAP ── -->
      <h4 class="fw-bold mb-3">
        <i class="fa-solid fa-map-location-dot me-2"></i>Where you'll be
      </h4>

      <div id="map" class="rounded-4 mb-3" style="height:380px; width:100%;"></div>

      <div class="d-flex gap-2 mb-5">
        <button onclick="changeStyle('streets')"
                class="btn btn-sm btn-outline-secondary rounded-pill px-3">
          🗺️ Street
        </button>
        <button onclick="changeStyle('dark')"
                class="btn btn-sm btn-outline-secondary rounded-pill px-3">
          🌑 Dark
        </button>
        <button onclick="changeStyle('light')"
                class="btn btn-sm btn-outline-secondary rounded-pill px-3">
          ☀️ Light
        </button>
        <button onclick="changeStyle('satellite')"
                class="btn btn-sm btn-outline-secondary rounded-pill px-3">
          🛰️ Satellite
        </button>
      </div>

      <hr class="my-4" />

      <!-- ── LEAVE A REVIEW ── -->
      <% if(currUser) { %>
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
          <h4 class="fw-bold mb-3">
            <i class="fa-solid fa-star me-2 text-warning"></i>Leave a Review
          </h4>

          <form
            action="/listings/<%= listing._id %>/reviews"
            method="POST"
            novalidate
            class="needs-validation">

            <div class="mb-3">
              <label class="form-label fw-semibold">Rating</label>
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate"
                       name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>

            <div class="mb-3">
              <label for="comment" class="form-label fw-semibold">Comment</label>
              <textarea
                name="review[comment]"
                id="comment"
                rows="4"
                class="form-control rounded-3"
                placeholder="Share your experience..."
                required></textarea>
              <div class="invalid-feedback">Please add a comment before submitting.</div>
            </div>

            <button class="btn btn-dark rounded-3 px-4" type="submit">
              <i class="fa-solid fa-paper-plane me-1"></i> Submit Review
            </button>

          </form>
        </div>
      <% } %>

      <!-- ── ALL REVIEWS ── -->
      <% if(listing.reviews.length > 0) { %>
        <h4 class="fw-bold mb-3">
          <i class="fa-solid fa-comments me-2"></i>All Reviews
        </h4>

        <div class="row g-3 mb-5">
          <% for (const review of listing.reviews) { %>
            <div class="col-md-6">
              <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                  <!-- Avatar + username -->
                  <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center fw-bold"
                         style="width:36px; height:36px; font-size:0.9rem; flex-shrink:0;">
                      <%= review.author.username[0].toUpperCase() %>
                    </div>
                    <div>
                      <div class="fw-semibold" style="font-size:0.9rem;">
                        @<%= review.author.username %>
                      </div>
                    </div>
                  </div>

                  <!-- Star rating -->
                  <p class="starability-result mb-2"
                     data-rating="<%= review.rating %>"></p>

                  <!-- Comment -->
                  <p class="text-muted mb-3" style="font-size:0.9rem; line-height:1.6;">
                    <%= review.comment %>
                  </p>

                  <!-- Delete (only review author) -->
                  <% if(currUser && currUser._id.equals(review.author._id)) { %>
                    <form method="POST"
                          action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                      <button class="btn btn-sm btn-outline-danger rounded-3">
                        <i class="fa-solid fa-trash me-1"></i>Delete
                      </button>
                    </form>
                  <% } %>

                </div>
              </div>
            </div>
          <% } %>
        </div>

      <% } else { %>
        <div class="text-center py-4 text-muted">
          <i class="fa-regular fa-star fa-2x mb-2 d-block"></i>
          No reviews yet — be the first to review!
        </div>
      <% } %>

    </div>
  </div>
</div>

<script src="/js/map.js"></script>

<script>
  (() => {
    document.querySelectorAll('.needs-validation').forEach(form => {
      form.addEventListener('submit', e => {
        if (!form.checkValidity()) {
          e.preventDefault();
          e.stopPropagation();
        }
        form.classList.add('was-validated');
      });
    });
  })();
</script>