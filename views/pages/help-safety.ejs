<% layout("layouts/boilerplate") %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <a href="/help" class="text-muted text-decoration-none mb-3 d-inline-block">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Help Centre
      </a>

      <h2 class="fw-bold mb-2">
        <i class="fa-solid fa-shield-halved me-2" style="color:#ff385c;"></i>Safety & Security
      </h2>
      <p class="text-muted mb-4">Your safety is our top priority. Learn how we keep you protected.</p>

      <!-- Safety tips cards -->
      <div class="row g-3 mb-5">
        <% [
          ['fa-lock',          'Secure account',    'Use a strong password and never share your login details with anyone.'],
          ['fa-eye-slash',     'Privacy first',     'Your personal information is never shared with other users without your consent.'],
          ['fa-triangle-exclamation', 'Report issues', 'Report any suspicious activity or listings immediately using the report feature.'],
          ['fa-shield-check',  'Verified listings', 'Look for verified badges on listings for an extra layer of trust and safety.'],
        ].forEach(([icon, title, desc]) => { %>
          <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
              <div class="d-flex gap-3 align-items-start">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:44px; height:44px; background:#fff4f4;">
                  <i class="fa-solid <%= icon %>" style="color:#ff385c;"></i>
                </div>
                <div>
                  <div class="fw-bold mb-1" style="font-size:0.95rem;"><%= title %></div>
                  <div class="text-muted" style="font-size:0.85rem; line-height:1.6;"><%= desc %></div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- FAQ Accordion -->
      <h5 class="fw-bold mb-3">Frequently Asked Questions</h5>
      <div class="accordion" id="safetyAccordion">
        <% [
          ['How do I report a suspicious listing?',
           'Go to the listing page and click the Report button. Provide details about your concern and our safety team will review it within 24 hours.'],
          ['What if I feel unsafe during my stay?',
           'Leave the property immediately if you feel unsafe. Contact local emergency services if necessary, then contact our 24/7 safety team.'],
          ['How does Wanderlust verify hosts?',
           'Hosts are verified through their email address and phone number during registration. We also review listings for policy compliance.'],
          ['Can I block another user?',
           'Yes. You can report and block any user who makes you feel uncomfortable. Our team will review all reported accounts.'],
          ['How do I report inappropriate content?',
           'Use the report feature on the listing or review page. Our moderation team reviews all reports within 24-48 hours.'],
          ['Is my personal data safe?',
           'Yes. We follow strict data protection guidelines. Your personal data is encrypted and never sold to third parties.'],
          ['What is Wanderlust\'s cancellation protection policy?',
           'If a host cancels within 24 hours of check-in, you are entitled to a full refund plus a 10% discount on your next booking.'],
        ].forEach(([q, a], i) => { %>
          <div class="accordion-item border-0 mb-2 rounded-3 shadow-sm overflow-hidden">
            <h2 class="accordion-header">
              <button
                class="accordion-button <%= i > 0 ? 'collapsed' : '' %> fw-semibold"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#safety<%= i %>"
                style="background:#fff;">
                <%= q %>
              </button>
            </h2>
            <div
              id="safety<%= i %>"
              class="accordion-collapse collapse <%= i === 0 ? 'show' : '' %>"
              data-bs-parent="#safetyAccordion">
              <div class="accordion-body text-muted" style="font-size:0.92rem; line-height:1.7;">
                <%= a %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Emergency Banner -->
      <div class="card border-0 rounded-4 p-4 mt-4"
           style="background:#fff4f4; border-left: 4px solid #ff385c !important;">
        <div class="d-flex align-items-start gap-3">
          <i class="fa-solid fa-phone mt-1" style="color:#ff385c; font-size:1.3rem;"></i>
          <div>
            <div class="fw-bold mb-1" style="color:#ff385c;">Emergency Contact</div>
            <p class="text-muted mb-2" style="font-size:0.88rem; line-height:1.6;">
              If you are in immediate danger, call your local emergency number first.
              Then contact our 24/7 Safety team.
            </p>
            <div class="d-flex gap-3 flex-wrap">
              <button class="btn rounded-3 fw-semibold px-4"
                      style="background:#ff385c; color:#fff; border:none; font-size:0.88rem;">
                <i class="fa-solid fa-phone me-2"></i>Emergency: 112
              </button>
              <button class="btn btn-outline-dark rounded-3 fw-semibold px-4"
                      style="font-size:0.88rem;">
                <i class="fa-solid fa-message me-2"></i>Safety team
              </button>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>