<% layout("layouts/boilerplate") %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-7">

      <!-- Hero -->
      <div class="text-center mb-5">
        <i class="fa-solid fa-user-group fa-3x mb-3" style="color:#ff385c;"></i>
        <h2 class="fw-bold">Refer a host</h2>
        <p class="text-muted" style="max-width:480px; margin:0 auto;">
          Know someone who has a great space to share?
          Invite them to host on Wanderlust and earn rewards together.
        </p>
      </div>

      <!-- How it works -->
      <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <h5 class="fw-bold mb-4">How it works</h5>
        <div class="d-flex flex-column gap-4">

          <div class="d-flex gap-3 align-items-start">
            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                 style="width:36px; height:36px; background:#ff385c; font-size:0.9rem;">1</div>
            <div>
              <div class="fw-semibold">Invite a friend</div>
              <div class="text-muted" style="font-size:0.88rem;">
                Share your unique referral link with someone who has a home to share.
              </div>
            </div>
          </div>

          <div class="d-flex gap-3 align-items-start">
            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                 style="width:36px; height:36px; background:#ff385c; font-size:0.9rem;">2</div>
            <div>
              <div class="fw-semibold">They list their home</div>
              <div class="text-muted" style="font-size:0.88rem;">
                Your friend signs up and lists their first property on Wanderlust.
              </div>
            </div>
          </div>

          <div class="d-flex gap-3 align-items-start">
            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                 style="width:36px; height:36px; background:#ff385c; font-size:0.9rem;">3</div>
            <div>
              <div class="fw-semibold">You both earn rewards</div>
              <div class="text-muted" style="font-size:0.88rem;">
                Once they complete their first booking, you both receive a bonus.
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Referral link box -->
      <div class="card border-0 bg-light rounded-4 p-4 text-center">
        <h6 class="fw-bold mb-3">Your referral link</h6>
        <% if(currUser) { %>
          <div class="input-group mb-3">
            <input type="text" class="form-control rounded-start-3"
                   value="https://wanderlust.app/ref/<%= currUser.username %>"
                   id="refLink" readonly />
            <button class="btn btn-dark rounded-end-3" onclick="copyLink()">
              <i class="fa-solid fa-copy me-1"></i>Copy
            </button>
          </div>
          <div class="d-flex justify-content-center gap-3">
            <button class="btn rounded-3 fw-semibold px-4"
                    style="background:#ff385c; color:#fff; border:none;">
              <i class="fa-brands fa-whatsapp me-2"></i>Share on WhatsApp
            </button>
            <button class="btn btn-outline-dark rounded-3 fw-semibold px-4">
              <i class="fa-solid fa-envelope me-2"></i>Send via Email
            </button>
          </div>
        <% } else { %>
          <p class="text-muted mb-3">Please log in to get your referral link.</p>
          <a href="/login" class="btn rounded-3 fw-semibold px-4"
             style="background:#ff385c; color:#fff; border:none;">
            Log in to refer
          </a>
        <% } %>
      </div>

    </div>
  </div>
</div>

<script>
  function copyLink() {
    const input = document.getElementById('refLink');
    navigator.clipboard.writeText(input.value).then(() => {
      const btn = input.nextElementSibling;
      btn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Copied!';
      btn.classList.replace('btn-dark', 'btn-success');
      setTimeout(() => {
        btn.innerHTML = '<i class="fa-solid fa-copy me-1"></i>Copy';
        btn.classList.replace('btn-success', 'btn-dark');
      }, 2000);
    });
  }
</script>