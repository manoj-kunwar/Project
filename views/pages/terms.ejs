<% layout("layouts/boilerplate") %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <a href="/listings" class="text-muted text-decoration-none mb-3 d-inline-block">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Home
      </a>

      <h2 class="fw-bold mb-1">
        <i class="fa-solid fa-file-contract me-2" style="color:#ff385c;"></i>Terms of Service
      </h2>
      <p class="text-muted mb-4">
        Last updated: <%= new Date().toLocaleDateString('en-US', { day:'numeric', month:'long', year:'numeric' }) %>
      </p>

      <!-- Intro -->
      <div class="card border-0 bg-light rounded-4 p-4 mb-4">
        <p class="text-muted mb-0" style="line-height:1.8; font-size:0.92rem;">
          Please read these Terms of Service carefully before using the Wanderlust platform.
          By accessing or using our service, you agree to be bound by these terms.
          If you disagree with any part, you may not use our service.
        </p>
      </div>

      <!-- Sections -->
      <% [
        ['fa-handshake', 'Acceptance of Terms',
          'By accessing and using Wanderlust, you accept and agree to be bound by these Terms of Service and our Privacy Policy. If you do not agree to these terms, please do not use our service. We reserve the right to modify these terms at any time.'],

        ['fa-user-check', 'User Accounts',
          'To use certain features of our service, you must register for an account. You are responsible for maintaining the confidentiality of your account credentials and for all activities that occur under your account. You must provide accurate and complete information when creating your account.'],

        ['fa-house', 'Listing Rules',
          'Hosts are responsible for ensuring their listings are accurate, legal, and comply with all applicable laws and regulations. Listings must not contain false, misleading, or deceptive information. Wanderlust reserves the right to remove any listing that violates our policies.'],

        ['fa-star', 'Reviews and Ratings',
          'Users may leave reviews and ratings for listings they have visited. Reviews must be honest, accurate, and based on actual experience. We prohibit fake reviews, incentivized reviews, or reviews that violate our content policies. We reserve the right to remove reviews that violate these guidelines.'],

        ['fa-ban', 'Prohibited Activities',
          'You agree not to use our service for any unlawful purpose; to harass, abuse, or harm another person; to impersonate any person or entity; to post false or misleading information; to attempt to gain unauthorized access to our systems; or to engage in any activity that disrupts or interferes with our service.'],

        ['fa-rupee-sign', 'Payments and Fees',
          'Wanderlust may charge service fees for use of the platform. All fees are clearly displayed before any transaction is completed. Prices listed by hosts are in Indian Rupees and are inclusive of applicable taxes unless stated otherwise. All payments are processed securely through our payment system.'],

        ['fa-circle-xmark', 'Cancellations and Refunds',
          'Cancellation policies vary by listing and are set by the host. Guests should review the cancellation policy before making a booking. Refunds are processed according to the applicable cancellation policy. Wanderlust is not responsible for any loss arising from a cancellation.'],

        ['fa-gavel', 'Limitation of Liability',
          'Wanderlust is not liable for any indirect, incidental, special, consequential, or punitive damages arising from your use of our service. Our total liability to you for any claim arising from use of our service shall not exceed the amount you paid to us in the 12 months prior to the claim.'],

        ['fa-flag', 'Governing Law',
          'These Terms shall be governed by and construed in accordance with the laws of India. Any disputes arising under these terms shall be subject to the exclusive jurisdiction of the courts of India.'],

      ].forEach(([icon, title, content]) => { %>
        <div class="mb-4">
          <h5 class="fw-bold mb-2">
            <i class="fa-solid <%= icon %> me-2" style="color:#ff385c; font-size:0.95rem;"></i>
            <%= title %>
          </h5>
          <p class="text-muted" style="font-size:0.92rem; line-height:1.8;"><%= content %></p>
          <hr class="text-muted opacity-25" />
        </div>
      <% }) %>

      <!-- Contact -->
      <div class="card border-0 bg-light rounded-4 p-4 text-center">
        <h6 class="fw-bold mb-2">Questions about our Terms?</h6>
        <p class="text-muted mb-3" style="font-size:0.88rem;">
          Contact our legal team at
          <a href="mailto:legal@wanderlust.com" style="color:#ff385c;">
            legal@wanderlust.com
          </a>
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
          <button class="btn rounded-3 fw-semibold px-4"
                  style="background:#ff385c; color:#fff; border:none;">
            <i class="fa-solid fa-envelope me-2"></i>Contact Legal Team
          </button>
          <a href="/privacy" class="btn btn-outline-dark rounded-3 fw-semibold px-4">
            <i class="fa-solid fa-lock me-2"></i>View Privacy Policy
          </a>
        </div>
      </div>

    </div>
  </div>
</div>